# CTR Native - build para PS2 (PS2SDK + gsKit).
#
# Uso (dentro de la imagen Docker ps2dev/ps2dev o con PS2SDK instalado):
#   make -f Makefile.ps2
#
# Genera ctr_ps2.elf. El build de PC (CMake) no se ve afectado.

EE_BIN = ctr_ps2.elf
EE_OBJS = main_ps2.o platform/ps2/ps2_cd.o platform/ps2/ps2_spu2.o audsrv_irx.o ctrspu2_irx.o

EE_INCS = -I. -Iinclude -Iplatform/ps2/include -I$(GSKIT)/include

# -fno-strict-aliasing: el codigo descompilado lee datos con tipos distintos a
# los que se escribieron (p. ej. gte_ldv0 lee un SVECTOR de s16 como u32). Sin
# esta opcion GCC -O2 puede reordenar esas lecturas antes de las escrituras.
EE_CFLAGS = -std=gnu17 -DCTR_NATIVE -DCTR_PS2 -fno-strict-aliasing \
	-Wno-error=incompatible-pointer-types \
	-Wno-error=int-conversion \
	-Wno-error=implicit-function-declaration

EE_LDFLAGS = -L$(GSKIT)/lib
# libpadx: libreria de mandos para rom0:XPADMAN (ver main_ps2.c).
EE_LIBS = -lgskit -ldmakit -lpadx -lcdvd -laudsrv -lpatches -lm

all: $(EE_BIN)

# Modulo de audio del IOP incrustado en el ELF.
audsrv_irx.c: $(PS2SDK)/iop/irx/audsrv.irx
	$(PS2SDK)/bin/bin2c $< $@ audsrv_irx

# Modulo propio del IOP (iop/ctrspu2): manda el sonido al chip SPU2.
iop/ctrspu2/ctrspu2.irx: iop/ctrspu2/ctrspu2.c iop/ctrspu2/ctrspu2_rpc.h iop/ctrspu2/imports.lst iop/ctrspu2/irx_imports.h
	$(MAKE) -C iop/ctrspu2

ctrspu2_irx.c: iop/ctrspu2/ctrspu2.irx
	$(PS2SDK)/bin/bin2c $< $@ ctrspu2_irx

platform/ps2/ps2_spu2.o: platform/ps2/ps2_spu2.h iop/ctrspu2/ctrspu2_rpc.h

clean:
	rm -f $(EE_BIN) $(EE_OBJS) audsrv_irx.c ctrspu2_irx.c
	$(MAKE) -C iop/ctrspu2 clean

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal
